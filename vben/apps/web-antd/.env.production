# 前端独立端口部署（8888），静态资源与 API 服务器（8889）分离
VITE_BASE=/

# 默认 API 地址：构建后可通过 dist/_app-config-*.js 在运行时覆盖为
# http://127.0.0.1:8889/api ，无需重新打包
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式：hash 模式可从静态目录直接托管，无需服务端重写
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=false
