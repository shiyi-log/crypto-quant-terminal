# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址：开发环境走 vite 代理转发到认证服务（8890）
#   /ftapi/api/v1/*  → http://127.0.0.1:8890/api/v1/*
#   /ftapi/auth/*    → http://127.0.0.1:8890/auth/*
VITE_GLOB_API_URL=/ftapi/api

# 关闭 Nitro Mock 服务（我们对接真实 Freqtrade API）
VITE_NITRO_MOCK=false

# 是否打开 devtools
VITE_DEVTOOLS=false

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true
