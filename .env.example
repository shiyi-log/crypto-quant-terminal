# 本机 PostgreSQL 连接；真实密码只写入被忽略的 .env。
QUANT_DATABASE_URL=postgresql://quant_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5433/quant_terminal
# 测试必须使用独立数据库。
QUANT_TEST_DATABASE_URL=postgresql://quant_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5433/quant_test
QUANT_STREAM_ENABLED=true
QUANT_STREAM_MARKET=futures
QUANT_STREAM_PAIRS=BTC/USDT:USDT,ETH/USDT:USDT
# 首次初始化可填写密码；留空时自动生成。已有用户不会被覆盖。
QUANT_BOOTSTRAP_PASSWORD=
